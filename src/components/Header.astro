---
import { getNews } from '../lib/data';

const path = Astro.url.pathname;
const news = await getNews();
const items = [
  { href: '/publications/', label: 'Publications' },
  { href: '/projects/', label: 'Projects' },
  { href: '/cv/', label: 'CV' },
  ...(news.length ? [{ href: '/news/', label: 'News' }] : []),
];
const current = (href: string) => (path === href ? 'page' : path.startsWith(href) ? 'true' : undefined);
---

<header class="site-header">
  <div class="container">
    <a class="wordmark" href="/">Saeed Rafieyan</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          items.map((i) => (
            <li>
              <a href={i.href} aria-current={current(i.href)}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button type="button" class="theme-toggle" aria-pressed="false" aria-label="Dark theme" hidden>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 2a8 8 0 0 1 0 16z" fill="currentColor"></path>
      </svg>
    </button>
  </div>
</header>
