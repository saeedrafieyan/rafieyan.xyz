---
import type { NewsItem } from '../lib/data';
import { newsIsPost } from '../lib/data';
import { isoDay, monthYear } from '../lib/dates';

interface Props {
  item: NewsItem;
  marginDates?: boolean;
}
const { item, marginDates = false } = Astro.props;
const d = item.data;
const isPost = newsIsPost(item);
---

<li class:list={['news-item', { 'with-margin': marginDates }]} id={`news-${item.id}`}>
  <time class:list={['news-date', { margin: marginDates }]} datetime={isoDay(d.date)}>{monthYear(d.date)}</time>
  <div class={marginDates ? 'main' : undefined}>
    {
      isPost ? (
        <>
          <h3 class="news-post-title">
            <a href={`/news/${item.id}/`}>{d.title}</a>
          </h3>
          <p class="news-text muted">{d.description ?? d.text}</p>
        </>
      ) : (
        <p class="news-text">
          {d.text}
          {d.link && (
            <>
              {' '}
              <a href={d.link}>
                {d.link_label ?? (
                  <>
                    Read more<span class="visually-hidden">: {d.text.split(' ').slice(0, 10).join(' ')}…</span>
                  </>
                )}
              </a>
            </>
          )}
        </p>
      )
    }
  </div>
</li>
