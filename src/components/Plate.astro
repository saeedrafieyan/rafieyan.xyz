---
import { responsive } from '../lib/images';

interface Props {
  image: string;
  alt: string;
  caption?: string;
  figure?: number;
  eager?: boolean;
  /** Rendered width hint for srcset. */
  sizes?: string;
}
const { image, alt, caption, figure, eager = false, sizes = '(min-width: 40rem) 14rem, calc(100vw - 2rem)' } = Astro.props;
const r = responsive(image);
---

<figure class="plate">
  <div class="plate-box">
    <img
      src={r?.src ?? image}
      srcset={r?.srcset}
      sizes={r ? sizes : undefined}
      width={r?.width}
      height={r?.height}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  </div>
  {
    caption && (
      <figcaption>
        {figure && <b>Fig. {figure}. </b>}
        {caption}
      </figcaption>
    )
  }
</figure>
