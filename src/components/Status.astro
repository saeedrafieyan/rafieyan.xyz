---
import { STATUS_LABELS } from '../lib/data';
interface Props {
  /** Publication status (published, ahead-of-print, …), mapped to its label. */
  status?: string;
  /** Ready-made text, e.g. a project's status label. "A · B" shows as two badges. */
  label?: string;
}
const { status, label: given } = Astro.props;
const label = given ?? (status ? (STATUS_LABELS[status] ?? (status === 'published' ? '' : status)) : '');
// Separate badges wrap as whole words on narrow screens instead of one long box.
const parts = label
  .split(/\s+·\s+/)
  .map((s) => s.trim())
  .filter(Boolean);
---

{
  parts.map((part) => (
    <>
      {' '}
      <span class="status">{part}</span>
    </>
  ))
}
