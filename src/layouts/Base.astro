---
import { Font, fontData } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProfile, homeTitle } from '../lib/data';

interface Props {
  /** Page name; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: object | object[];
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Show the footer's contact column (off where the page has its own contact section). */
  footerContact?: boolean;
}

const profileEntry = await getProfile();
const profile = profileEntry.data;
const { title, description, type = 'website', jsonLd, noindex = false, footerContact = true } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : homeTitle(profileEntry);
const desc = description ?? profile.description ?? profile.standfirst;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
// fontProviders.local() sets no subset metadata, so <Font preload> filters can't pick a face.
// Preload the first Inter face (latin, normal; see the variant order in astro.config.mjs).
const interLatin = fontData['--font-inter']?.find((f) => f.style === 'normal')?.src[0]?.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1424" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: news`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${profile.name}, ${profile.role}, ${profile.institute.short}, ${profile.city}${profile.tagline ? `: ${profile.tagline}` : ''}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    {interLatin && <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />}
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-crimson" />
    <Font cssVariable="--font-atkmono" />
    <slot name="head" />
    {
      (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content" class="container">
      <slot />
    </main>
    <Footer showContact={footerContact} />
    <div class="visually-hidden" aria-live="polite" data-announcer></div>

    <script>
      const root = document.documentElement;
      const announcer = document.querySelector<HTMLElement>('[data-announcer]');
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const reset = document.querySelector<HTMLButtonElement>('[data-theme-reset]');
      const media = matchMedia('(prefers-color-scheme: dark)');
      const effective = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');
      const stored = () => {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      };
      const sync = () => {
        toggle?.setAttribute('aria-pressed', String(effective() === 'dark'));
        // Never hide the reset button while it has focus (that would drop focus to <body>).
        if (reset) reset.hidden = !stored() && document.activeElement !== reset;
      };
      const withoutTransitions = (fn: () => void) => {
        root.classList.add('theme-switching');
        fn();
        requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
      };

      if (toggle) {
        toggle.addEventListener('click', () =>
          withoutTransitions(() => {
            const next = effective() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('theme', next);
            } catch {}
            sync();
          }),
        );
      }
      reset?.addEventListener('click', () =>
        withoutTransitions(() => {
          delete root.dataset.theme;
          try {
            localStorage.removeItem('theme');
          } catch {}
          sync();
          if (announcer) announcer.textContent = 'Using system theme';
        }),
      );
      reset?.addEventListener('blur', sync);
      media.addEventListener('change', sync);
      sync();

      // Copy buttons: BibTeX panels and the CV's short bio
      if (navigator.clipboard) {
        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
          button.hidden = false;
          button.addEventListener('click', async () => {
            const panel = button.closest('.bibtex-panel, .copy-panel');
            const text = (panel?.querySelector('[data-copy-source], pre')?.textContent ?? '').trim();
            try {
              await navigator.clipboard.writeText(text);
              button.textContent = 'Copied';
              if (announcer) announcer.textContent = 'Copied to clipboard';
              setTimeout(() => {
                button.textContent = button.dataset.copyLabel ?? 'Copy BibTeX';
                if (announcer) announcer.textContent = '';
              }, 2000);
            } catch {
              button.textContent = 'Copy failed';
            }
          });
        }
      }
    </script>
  </body>
</html>
