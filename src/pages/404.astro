---
import Base from '../layouts/Base.astro';
import Woodpile from '../components/Woodpile.astro';
import { getProfile } from '../lib/data';

const { data: p } = await getProfile();
---

<Base title="Page not found" noindex>
  <div class="page-grid">
    <header class="with-margin">
      <div class="main">
        <p class="kicker">Error 404 · Erratum</p>
        <h1 class="page-title">Page not found</h1>
        <p class="standfirst">This page does not exist. It may have moved when the site left sraf.ir.</p>
      </div>
    </header>
    <div class="with-margin">
      <div class="main">
        <figure class="notfound-figure">
          <Woodpile variant="defect" scale={2} />
          <figcaption>Fig. 404. A missing strand.</figcaption>
        </figure>
        <ul class="cv-plain" style="margin-top: var(--space-l)">
          <li><a href="/">Home</a></li>
          <li><a href="/publications/">Publications</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li><a href="/cv/">CV</a></li>
          <li><a href={`mailto:${p.email}`}>{p.email}</a></li>
        </ul>
      </div>
    </div>
  </div>
</Base>
