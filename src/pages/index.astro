---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Woodpile from '../components/Woodpile.astro';
import InlineList from '../components/InlineList.astro';
import PubItem from '../components/PubItem.astro';
import FeaturedRow from '../components/FeaturedRow.astro';
import NewsItem from '../components/NewsItem.astro';
import { getCv, getNews, getProfile, getProjects, getPublications, projectHref, pubCountLabel } from '../lib/data';
import { homeGraph } from '../lib/jsonld';
import { contentLastmod } from '../lib/lastmod.mjs';
import { formatPartial } from '../lib/dates';
import { responsive } from '../lib/images';

const profile = await getProfile();
const p = profile.data;
const { Content } = await render(profile);
const pubs = await getPublications();
const selected = pubs.filter((x) => x.data.selected).slice(0, 5);
const projects = await getProjects();
const featured = projects.filter((x) => x.data.tier === 'featured').slice(0, 3);
// Number only figures that actually show a "Fig. N" caption, so numbering always starts at 1.
let fig = 0;
const figNos = featured.map((x) => (x.data.figure?.caption ? ++fig : undefined));
const news = await getNews();
const recent = news.slice(0, 3);
const portrait = p.portrait ? responsive(p.portrait.image) : undefined;

/** "3 articles + MSc thesis", linked to the Publications page filtered by that topic. */
const topicLink = (topic?: string) => {
  const items = topic ? pubs.filter((x) => x.data.topics.includes(topic)) : [];
  const label = pubCountLabel(items);
  return label ? { label, href: `/publications/?topic=${topic}` } : undefined;
};
const themes = p.focus.map((f) => ({
  ...f,
  links: [
    ...f.projects.map((id) => {
      const project = projects.find((x) => x.id === id);
      if (!project) {
        throw new Error(
          `Profile → Research themes "${f.term}": project "${id}" does not exist. Use the project's file name without .md.`,
        );
      }
      return { label: project.data.title, href: projectHref(project) };
    }),
    ...[topicLink(f.topic)].filter((l) => l !== undefined),
  ],
}));
const other = p.other_research.map((o) => ({ ...o, pubs: topicLink(o.topic) }));

const { data: cv } = await getCv();
const jsonLd = homeGraph(profile, Astro.site!, cv.education, contentLastmod()['/']);
---

<Base type="profile" jsonLd={jsonLd} footerContact={false}>
  <div class="page-grid">
    <section class="with-margin hero" aria-labelledby="name">
      {
        p.portrait && (
          <div class="margin">
            <figure class="portrait">
              <img
                src={portrait?.src ?? p.portrait.image}
                srcset={portrait?.srcset}
                sizes={portrait ? '(min-width: 60rem) 11rem, 5rem' : undefined}
                width={portrait?.width}
                height={portrait?.height}
                alt={p.portrait.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
          </div>
        )
      }
      <div class="main">
        {p.tagline && <p class="kicker">{p.tagline}</p>}
        <h1 class="display-name" id="name">{p.name}</h1>
        <p class="standfirst">{p.standfirst}</p>
        <p class="meta-line">
          {p.role},{' '}
          {p.institute.url ? <a href={p.institute.url}>{p.institute.name}</a> : p.institute.name}, {p.city}
        </p>
        {
          p.now && (
            <p class="now-line">
              <strong>Now{p.now.date && ` (${formatPartial(p.now.date)})`}:</strong> {p.now.text}
            </p>
          )
        }
        <div class="action-row">
          <a class="btn btn-primary" href="/projects/">Research projects</a>
          <a class="btn" href="/publications/">Publications</a>
          <InlineList
            label={`More about ${p.name}`}
            links={[
              { label: 'CV', href: '/cv/' },
              { label: 'Contact', href: '#contact' },
              { label: 'Google Scholar', href: p.profiles.scholar },
              { label: 'ORCID', href: p.profiles.orcid },
              { label: 'GitHub', href: p.profiles.github },
            ]}
          />
        </div>
        <Woodpile class="woodpile-rule" />
      </div>
    </section>

    <section class="with-margin" aria-labelledby="research">
      <h2 class="section-head margin" id="research">Research</h2>
      <div class="main">
        <div class="prose"><Content /></div>
        {
          themes.length > 0 && (
            <>
              <h3 class="subhead" id="themes">
                Research themes
              </h3>
              <dl class="focus-list">
                {themes.map((t) => (
                  <>
                    <dt>{t.term}</dt>
                    <dd>
                      <p>{t.description}</p>
                      {t.links.length > 0 && (
                        <p class="focus-links">
                          <span class="muted">Related:</span>{' '}
                          {t.links.map((l, i) => (
                            <>
                              {i > 0 && (
                                <span class="sep" aria-hidden="true">
                                  {' · '}
                                </span>
                              )}
                              <a href={l.href}>{l.label}</a>
                            </>
                          ))}
                        </p>
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            </>
          )
        }
        {
          other.length > 0 && (
            <>
              <h3 class="subhead" id="other-research">
                Other research collaborations
              </h3>
              <ul class="other-research">
                {other.map((o) => (
                  <li>
                    <b>{o.term}.</b> {o.description}
                    {o.pubs && (
                      <>
                        {' '}
                        <a href={o.pubs.href}>{o.pubs.label}&nbsp;→</a>
                      </>
                    )}
                  </li>
                ))}
              </ul>
            </>
          )
        }
        {p.also_exploring.length > 0 && <p class="also">Also exploring: {p.also_exploring.join(' · ')}.</p>}
      </div>
    </section>

    {
      featured.length > 0 && (
        <section class="with-margin" aria-labelledby="work">
          <h2 class="section-head margin" id="work">
            Featured projects
          </h2>
          <div class="main">
            {featured.map((proj, i) => (
              <FeaturedRow project={proj} figure={figNos[i]} />
            ))}
            <p class="section-foot">
              <a href="/projects/">All projects and tools →</a>
            </p>
          </div>
        </section>
      )
    }

    {
      selected.length > 0 && (
        <section class="with-margin" aria-labelledby="selected">
          <h2 class="section-head margin" id="selected">
            Selected publications
          </h2>
          <div class="main">
            <ul class="pub-list">
              {selected.map((pub) => (
                <PubItem pub={pub} mode="compact" />
              ))}
            </ul>
            <p class="section-foot">
              <a href="/publications/">All {pubs.length} publications →</a>
            </p>
          </div>
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="with-margin" aria-labelledby="news">
          <h2 class="section-head margin" id="news">
            Recent news
          </h2>
          <div class="main">
            <ul class="news-list">
              {recent.map((n) => (
                <NewsItem item={n} />
              ))}
            </ul>
            {news.length > recent.length && (
              <p class="section-foot">
                <a href="/news/">All news →</a>
              </p>
            )}
          </div>
        </section>
      )
    }

    <section class="with-margin" aria-labelledby="contact">
      <h2 class="section-head margin" id="contact">Contact</h2>
      <div class="main">
        {p.contact_note && <p class="contact-note">{p.contact_note}</p>}
        <p class="contact-email"><a href={`mailto:${p.email}`}>{p.email}</a></p>
        <p class="meta-line">{p.institute.name}, {p.city}</p>
      </div>
    </section>
  </div>
</Base>
