---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import PubItem from '../../components/PubItem.astro';
import InlineList from '../../components/InlineList.astro';
import Status from '../../components/Status.astro';
import {
  getProfile,
  getProjects,
  getPublications,
  projectHasPage,
  projectStatusLabel,
  projectYears,
  pubHref,
  type Project,
} from '../../lib/data';
import { breadcrumbs, projectLd } from '../../lib/jsonld';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.filter(projectHasPage).map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
const d = project.data;
const { data: profile } = await getProfile();
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
const pubs = await getPublications();
// getProjects() has already checked that every version's publication exists.
const versions = d.versions.map((v) => ({ ...v, pub: pubs.find((p) => p.id === v.publication) }));
const versionIds = new Set(d.versions.map((v) => v.publication));
const related = pubs.filter((p) => p.data.projects.includes(project.id) || versionIds.has(p.id));
const canonical = versions.at(-1)?.pub ?? related[0];
const years = projectYears(project);
const facts = [
  ['Role', d.role],
  ['Methods', d.methods],
  ['Data', d.data],
  ['Licence', d.licence],
].filter(([, v]) => v);
const site = Astro.site!;
const jsonLd = [
  projectLd(project, related, site, profile.name, canonical),
  breadcrumbs(site, [
    { name: profile.name, path: '/' },
    { name: 'Projects', path: '/projects/' },
    { name: d.title, path: `/projects/${project.id}/` },
  ]),
];
---

<Base title={d.full_name ? `${d.title}: ${d.full_name}` : d.title} description={d.summary} type="article" jsonLd={jsonLd}>
  <article class="page-grid">
    <header class="with-margin">
      <div class="main">
        <p class="kicker">
          {['Project', years, `${profile.name}${d.role ? `, ${d.role.toLowerCase()}` : ''}`].filter(Boolean).join(' · ')}
        </p>
        <h1 class="page-title">{d.title}</h1>
        {d.full_name && <p class="project-fullname">{d.full_name}</p>}
        {projectStatusLabel(project) && (
          <p class="project-status">
            <Status label={projectStatusLabel(project)} />
          </p>
        )}
        <p class="standfirst">{d.summary}</p>
        {
          facts.length > 0 && (
            <dl class="facts">
              {facts.map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))}
            </dl>
          )
        }
        <InlineList
          class="project-links"
          label={`${d.title} links`}
          links={[
            { label: 'Code', href: d.links.code },
            { label: 'Web app', href: d.links.app },
            { label: 'Model', href: d.links.model },
            { label: 'Dataset', href: d.links.dataset },
            { label: 'DOI', href: d.links.doi && `https://doi.org/${d.links.doi}` },
          ]}
        />
      </div>
    </header>

    {
      d.figure && (
        <div class="with-margin">
          <div class="full">
            <Plate
              image={d.figure.image}
              alt={d.figure.alt}
              caption={d.figure.caption}
              figure={1}
              eager
              wide
              zoom
              sizes="(min-width: 80rem) 1200px, (min-width: 40rem) calc(100vw - 4rem), calc(100vw - 2rem)"
            />
          </div>
        </div>
      )
    }

    {
      versions.length > 0 && (
        <section class="with-margin" aria-labelledby="versions">
          <h2 class="section-head margin" id="versions">
            Versions
          </h2>
          <div class="main scroll-region" role="region" tabindex="0" aria-label={`${d.title} versions`}>
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">Version</th>
                  <th scope="col">Year</th>
                  <th scope="col">Scope</th>
                  <th scope="col">Paper</th>
                </tr>
              </thead>
              <tbody>
                {versions.map((v) => (
                  <tr>
                    <td>{v.version}</td>
                    <td class="tabular">{v.year}</td>
                    <td>{v.scope}</td>
                    <td>{v.pub ? <a href={pubHref(v.pub)}>{v.pub.data.venue}</a> : 'Not published'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      hasBody && (
        <section class="with-margin" aria-labelledby="about-project">
          <h2 class="section-head margin" id="about-project">
            About
          </h2>
          <div class="main prose">
            <Content />
          </div>
        </section>
      )
    }

    {
      (canonical || d.bibtex) && (
        <section class="with-margin" aria-labelledby="cite">
          <h2 class="section-head margin" id="cite">
            How to cite
          </h2>
          <div class="main bibtex-panel">
            {canonical ? (
              <p>
                Please cite <a href={pubHref(canonical)}>{canonical.data.title}</a>.
              </p>
            ) : (
              <p>
                Please cite {d.title}
                {d.links.doi && (
                  <>
                    {' '}
                    (<a href={`https://doi.org/${d.links.doi}`}>doi:{d.links.doi}</a>)
                  </>
                )}
                .
              </p>
            )}
            <div class="copy-row">
              <button type="button" class="btn btn-small" data-copy hidden>
                Copy BibTeX
              </button>
            </div>
            <pre role="region" tabindex="0" aria-label={`BibTeX for ${d.title}`}>{canonical?.bibtex ?? d.bibtex}</pre>
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="with-margin" aria-labelledby="related">
          <h2 class="section-head margin" id="related">
            Related publications
          </h2>
          <ul class="pub-list main">
            {related.map((pub) => (
              <PubItem pub={pub} mode="compact" />
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
