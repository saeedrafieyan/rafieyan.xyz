---
import Base from '../../layouts/Base.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import { getProfile, getProjects, projectHasPage, projectYears } from '../../lib/data';

const { data: profile } = await getProfile();
const projects = await getProjects();
const research = projects.filter((p) => p.data.tier !== 'minor' && p.data.category === 'research');
const resources = projects.filter((p) => p.data.tier !== 'minor' && p.data.category === 'resource');
const minor = projects.filter((p) => p.data.tier === 'minor');

const titles = (list: typeof projects) => list.map((p) => p.data.title).join(', ');
const description = [
  research.length && `Research projects by ${profile.name}: ${titles(research)}.`,
  resources.length && `Tools and resources: ${titles(resources)}.`,
]
  .filter(Boolean)
  .join(' ');
---

<Base title="Projects" description={description}>
  <div class="page-grid">
    <header class="with-margin">
      <div class="main">
        <h1 class="page-title">Projects</h1>
        <p class="standfirst">Current research, followed by tools and resources.</p>
      </div>
    </header>

    {
      research.length > 0 && (
        <section class="with-margin" aria-labelledby="current-research">
          <h2 class="section-head margin" id="current-research">
            Current research
          </h2>
          <div class="main">
            {research.map((p) => (
              <ProjectEntry project={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      resources.length > 0 && (
        <section class="with-margin" aria-labelledby="tools-resources">
          <h2 class="section-head margin" id="tools-resources">
            Tools and resources
          </h2>
          <div class="main">
            {resources.map((p) => (
              <ProjectEntry project={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      minor.length > 0 && (
        <section class="with-margin" aria-labelledby="other-utilities">
          <h2 class="section-head margin" id="other-utilities">
            Other utilities
          </h2>
          <ul class="minor-list main">
            {minor.map((p) => {
              const link = p.data.links.code ?? p.data.links.app;
              const linkLabel = p.data.links.code ? 'Code' : 'Web app';
              const years = projectYears(p)?.replace(/–present$/, '');
              return (
                <li id={p.id}>
                  {projectHasPage(p) ? (
                    <a href={`/projects/${p.id}/`}>
                      <b>{p.data.title}</b>
                    </a>
                  ) : (
                    <b>{p.data.title}</b>
                  )}{' '}
                  {years && `· ${years} `}
                  {p.data.summary && `· ${p.data.summary}`}
                  {link && (
                    <>
                      {' · '}
                      <a href={link}>{linkLabel}</a>
                    </>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }
  </div>
</Base>
